# Configure on the machine that runs the bot. Never commit real credentials.
TELEGRAM_BOT_TOKEN=
DRIVER_GROUP_1=
DRIVER_GROUP_2=
BRAND_GROUP=
ARCHIVE_GROUP=
# Private channel: numeric -100... ID; public channel: @username
SUBSCRIPTION_CHANNEL_ID=@WB_HUMO_TAXI
CODECRAFT_API_KEY=
CODECRAFT_VISION_MODEL=gpt-5.6-luna

# Separate review queues. Optional city overrides: TASHKENT_/NAMANGAN_ prefix.
INCOMPLETE_GROUP=
OTHER_PARK_GROUP=
# Optional Telegram sticker file IDs, obtained by replying /asset_id to a sticker.
WELCOME_STICKER_ID=
SUCCESS_STICKER_ID=
# Optional custom emoji IDs. Bot owner must have Telegram Premium, or an eligible
# bot username on Fragment. Leave blank to use standard emoji and colored buttons.
PREMIUM_ICON_READY=
PREMIUM_ICON_PROGRESS=
PREMIUM_ICON_INCOMPLETE=
PREMIUM_ICON_OTHERPARK=
PREMIUM_ICON_DELETE=
# User-supplied test review groups (set in .env.test):
# INCOMPLETE_GROUP=
# OTHER_PARK_GROUP=
# ARCHIVE_GROUP=...  # still required to use Ready in the test bot

# Set 0 to stop sending documents to CodeCraft.
DOCUMENT_AI_ENABLED=1
